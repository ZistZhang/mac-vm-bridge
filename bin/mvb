#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

chmod +x "$ROOT/scripts/"*.sh 2>/dev/null || true

SKIP_BOOTSTRAP=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --skip-bootstrap) SKIP_BOOTSTRAP=1; shift ;;
    *) break ;;
  esac
done

if [ "$SKIP_BOOTSTRAP" -eq 0 ]; then
  "$ROOT/scripts/bootstrap.sh"
fi

"$ROOT/scripts/wizard.sh" "$@"
